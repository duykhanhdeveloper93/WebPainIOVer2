nuocngavidai.duckdns.org {

    encode gzip

    # Health check
    handle /health {
        respond "OK" 200
    }

    # API (strip /api -> đúng vì backend đã có /api)
    handle_path /api/* {
        reverse_proxy backend:3000
    }

    # Socket (KHÔNG strip path)
    handle /socket.io/* {
        reverse_proxy backend:3000
    }

    # Frontend
    handle {
        reverse_proxy frontend:80
    }
}